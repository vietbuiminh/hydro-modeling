#!/bin/sh
set -eu

# Run Julia formatter before every commit.
julia -e 'using Pkg; Pkg.add("JuliaFormatter")' >/dev/null 2>&1 || true
julia -e 'using JuliaFormatter; format(".")'

# Wrap long comment lines to a consistent width. Code lines are left to
# JuliaFormatter: splitting them at operators can change how Julia parses them
# (e.g. `x .^ -1` became `x .^ -` + `1`, which broke solve_flow).
python3 - <<'PY'
from pathlib import Path
import re

MAX = 120


def wrap_line(line: str) -> str:
    s = line.rstrip("\n")
    if len(s) <= MAX:
        return line

    # Preserve leading indentation.
    m = re.match(r"^(\s*)", s)
    indent = m.group(1)
    body = s[len(indent):]

    # Only comments are wrapped; code lines are returned unchanged.
    if not body.startswith("#"):
        return line

    prefix = indent + "# "
    rest = body[2:]
    words = rest.split()
    if not words:
        return line
    out = []
    current = prefix
    for w in words:
        candidate = current + (" " if current != prefix else "") + w
        if len(candidate) <= MAX:
            current = candidate
        else:
            out.append(current.rstrip())
            current = prefix + w
    if current.strip():
        out.append(current.rstrip())
    return "\n".join(out) + "\n"


for path in Path(".").rglob("*.jl"):
    if path.is_dir():
        continue
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines(keepends=True)
    wrapped = []
    for line in lines:
        if len(line.rstrip("\n")) > MAX:
            wrapped.append(wrap_line(line))
        else:
            wrapped.append(line)
    path.write_text("".join(wrapped), encoding="utf-8")
PY

git add .
